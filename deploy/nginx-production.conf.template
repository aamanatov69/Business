# Include in nginx's http context. Replace certificate paths with existing files.
# Validate with nginx -t before reload. This does not replace the live config automatically.
map $http_upgrade $business_connection_upgrade {
    default upgrade;
    '' close;
}
map $uri $business_public_path {
    default $request_uri;
    /countries/kyrgyzstan /$is_args$args;
    /countries/kyrgyzstan/crm /solutions/crm-dlya-biznesa$is_args$args;
    /countries/kyrgyzstan/pos-terminaly /solutions/pos-terminaly-i-kassy$is_args$args;
    /countries/kyrgyzstan/vesy /solutions/torgovye-vesy-i-oborudovanie$is_args$args;
    /countries/kyrgyzstan/avtomatizaciya-sklada /solutions/avtomatizaciya-sklada-i-ucheta$is_args$args;
}

server {
    listen 80;
    server_name automationbusines.com www.automationbusines.com;
    # Preserve existing API methods/bodies and WebSocket handshakes during migration.
    location ^~ /api/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $business_connection_upgrade;
    }
    location / { return 301 https://automationbusines.com$business_public_path; }
}

server {
    listen 443 ssl;
    server_name www.automationbusines.com;
    ssl_certificate /etc/letsencrypt/live/automationbusines.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/automationbusines.com/privkey.pem;
    location ^~ /api/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host automationbusines.com;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $business_connection_upgrade;
    }
    location / { return 301 https://automationbusines.com$business_public_path; }
}

server {
    listen 443 ssl;
    server_name automationbusines.com;
    ssl_certificate /etc/letsencrypt/live/automationbusines.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/automationbusines.com/privkey.pem;
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json application/xml image/svg+xml;
    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $business_connection_upgrade;
        proxy_cache_bypass $http_upgrade;
    }
}
